# 모든 변형이 공유하는 무대. run.sh 가 이 파일 + 변형 파일을 .runtime.env 로 합쳐 두 앱에 그대로 넣는다.
TZ=Asia/Seoul
SPRING_PROFILES_ACTIVE=
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-master:3306/mydatabase?connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=secret
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
# 이 값이 있을 때만 라우팅 DataSource 가 등록된다(readOnly 트랜잭션 → 복제본).
APP_DATASOURCE_REPLICA_URL=jdbc:mysql://mysql-replica:3306/mydatabase?connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true
APP_DATASOURCE_REPLICA_USERNAME=myuser
APP_DATASOURCE_REPLICA_PASSWORD=secret
SPRING_DATA_REDIS_HOST=redis

# 힙은 전 변형 동일. 상한 없는 조회가 힙을 어떻게 쓰는지가 관측 대상이라 변형마다 바꾸지 않는다.
JAVA_OPTS=-Xmx2g -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp

# 슬라이스는 켜고 컨슈머만 끈다 - 100만 이벤트가 외부 유료 API 로 흐르면 안 된다.
INGESTION_V2_ENABLED=true
INGESTION_V2_AUTO_DELIVERY=true
INGESTION_CONSUME_ENABLED=false

# 발송 틱은 60초, 한 틱은 배치를 소진할 때까지 반복.
INGESTION_DISPATCH_INTERVAL_MS=60000
INGESTION_DISPATCH_DRAIN=true
INGESTION_DISPATCH_DRAIN_MAX_BATCHES=100000
INGESTION_MARKER_TTL_MS=300000
INGESTION_JOB_LOCK_TTL_MS=300000

# 관측이 대상을 바꾸지 않게: 미발행 행 수 계기(COUNT 질의)를 끈다.
INGESTION_OUTBOX_PENDING_GAUGE=false

# 실험 창에 끼어드는 다른 스케줄러를 전부 재운다('-' = 그 잡만 미등록).
#   트리밍이 살아 있으면 XLEN 이 상한으로 깎여 중복 대조가 거짓이 되고,
#   수집 회차가 살아 있으면 실제 외부 API 를 호출하며 아웃박스에 행을 더한다.
INGESTION_TRIM_CRON=-
INGESTION_CLEANUP_CRON=-
INGESTION_COLLECT_CRON=-
INGESTION_STREAM_MAX_LENGTH=3000000

# 부수 기능 정지.
GENRE_CLASSIFIER=mock
EXHIBITION_DEMO_SEED=false
APP_LOCAL_SEED_ENABLED=false

# 코어 스케줄러도 전부 재운다. 실험 창(약 13분)에 걸릴 수 있는 것이 넷이고,
# 넷 다 같은 MySQL·Redis 를 두드려 Com_select·commandstats 델타를 오염시킨다.
#   sync/relay/purge  = 전시 수집 v1(같은 DB의 다른 아웃박스)
#   cache warm        = 03·09·15·21시, view-count flush = 02:30·08:30·14:30·20:30 — 런이 그 시각에 걸리면 대량 조회
#   remind backfill   = fixedDelay 10분이라 기동 직후 한 번 반드시 돈다(AI 호출 경로)
#   cache watchdog    = fixedDelay 30초 Redis 재구독 — 끌 스위치가 없어 주기를 창 밖으로 민다
APP_EXHIBITION_ENRICH_SCHEDULING_ENABLED=false
EXHIBITION_SYNC_CRON=-
APP_EXHIBITION_OUTBOX_PURGE_CRON=-
APP_EXHIBITION_CACHE_WARM_CRON=-
APP_EXHIBITION_VIEW_COUNT_FLUSH_CRON=-
APP_REMIND_SUMMARY_BACKFILL_ENABLED=false
APP_CACHE_INVALIDATION_SUBSCRIBE_RETRY_DELAY_MS=86400000
