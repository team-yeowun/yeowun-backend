# 시연 ② 수평 확장 - ①과 같은 무대에서 도중에 app3 를 합류시켰다가 강제로 죽인다.
# 보는 것은 셋이다: 3대 구간에서 app3 가 실제로 배분을 받는가 · 죽은 뒤 그 미처리 목록이 회수되는가 · 유실이 0인가.
# 강제 종료(kill -9)여야 미처리 목록이 남는다 - compose stop 의 SIGTERM 이면 구독이 정리돼 회수 시연이 성립하지 않는다.
INGESTION_CLAIM_STRATEGY=REDIS_MARKER
INGESTION_OUTBOX_READ=MASTER
INGESTION_DISPATCH_BATCH_SIZE=500
INGESTION_DISPATCH_INTERVAL_MS=1000
# 컨슈머를 켜되 벤더는 부르지 않는다. 스텁 20ms 는 10만 행 소진이 app3 합류·회수를 담을 만큼 길어지는 값이다.
INGESTION_CONSUME_ENABLED=true
INGESTION_CONSUME_HANDLER=STUB
INGESTION_STUB_LATENCY_MS=20
# 회수를 런 안에서 보려면 방치 판정이 기본 60초보다 짧아야 한다.
INGESTION_RECLAIM_IDLE_SECONDS=15
INGESTION_RECLAIM_INTERVAL_MS=30000

LAB_INSTANCES=2
LAB_MODE=short
ROWS_PER_MINUTE=100000
SEED_CHUNKS=10
TMAX_SECONDS=1200
IDLE_SAMPLES=3

# 적재 종류. 컬럼과 payload 양쪽에 같은 값이 들어가고 배정 스트림은 ingestion.culture 하나가 된다.
SEED_EVENT_TYPE=DETAIL_READY
SEED_AGGREGATE_TYPE=ENRICHMENT
STREAM_KEY=ingestion.culture

# 원시값이 갈 곳. ${REPO} 는 run-push.sh 가 셸로 들여올 때 풀린다(컨테이너에는 넘기지 않는다).
PROBLEM_DIR=${REPO}/docs/전시수집_파이프라인_v2문서/AI-Driven-Development/problem/02-DB 폴링에서 Redis Streams 푸시로 전환

# T0 = RUN_STARTED(app1·app2 health UP 시각). 합류는 부팅 때문에 T+100 언저리가 된다.
LAB_APP3_START_SECONDS=60
LAB_APP3_KILL_SECONDS=220
